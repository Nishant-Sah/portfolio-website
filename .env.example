# Public site URL (used for canonical URLs, sitemap, Open Graph). No secrets here.
NEXT_PUBLIC_SITE_URL=https://your-domain.np

# Contact form delivery (optional). Create a free form at formspree.io and paste its endpoint.
# This URL is public by design (not a secret). If empty, the form opens the visitor's email app instead.
NEXT_PUBLIC_FORM_ENDPOINT=
